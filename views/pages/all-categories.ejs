<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/main.css">
    <title><%= title %></title>
  </head>
  <body>
    <h1><%= title %></h1>
    <a href="/categories/new"><button>Add new category</button></a>
    <% if (locals.categories) { %>
    <ul>
      <% categories.forEach((category) => { %>
      <li><%= category.name %></li>
      <% }) %>
    </ul>
    <% } else { %>
    <h2>No categories in your inventory</h2>
    <% } %>
  </body>
</html>
