<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/main.css">
  <link rel="stylesheet" href="/pages.css">
  <title><%= title %></title>
</head>

<body>
  <div class="item-cont">
    <% if (locals.item) { %>
    <div class="options">
      <h1><%= item.name %></h1>
      <a href="/items/<%= item.item_id %>/update"><button>Edit</button></a>
      <form action="/items/<%= item.item_id %>/delete" method="POST">
        <button type="submit">Delete</button>
      </form>
    </div>
    <p>Description: <%= item.description %></p>
    <p>Price: <%= item.price %></p>
    <p>Stock: <%= item.stock %></p>
    <p>First added to store: <%= formattedDate %></p>
    <p>Categories:</p>
    <div class="item-categories-cont">
      <% if(locals.categories) { %>
      <% categories.forEach((category) => { %>
      <%- include ('../components/category-card', {category: category}) %>
      <% })%>
      <% } else { %>
      <p>This item is not in any categories</p>
      <% } %>
    </div>
    <% } else { %>
    <h2>This item does not exist</h2>
    <% } %>
  </div>
</body>

</html>