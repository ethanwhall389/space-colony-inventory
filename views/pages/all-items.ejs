<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <h1><%= title %></h1>
    <% if (locals.items) { %> <% console.log('items!') %>
    <ul>
      <% items.forEach((item) => { %>
      <li><%= item %></li>
      <% }) %>
    </ul>
    <% } else { %>
    <h2>No items in your inventory</h2>
    <% } %>
  </body>
</html>
