<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/main.css">
  <link rel="stylesheet" href="/pages.css">
  <title><%= title %></title>
</head>

<body>
  <div class="category-cont">
    <% if (locals.category) { %>
    <div class="options">
      <h2><%= category.name %></h2>
      <a href="/categories/<%= category.category_id %>/update"><button>Edit</button></a>
      <form action="/categories/<%= category.category_id %>/delete" method="POST">
        <button type="submit">Delete</button>
      </form>
    </div>
    <p class="description-heading"><%= category.description_heading %></p>
    <p>Description: <%= category.description %></p>
    <div class="category-items">
      <% items.forEach((item) => { %>
      <%- include('../components/item-card', {item: item}) %>
      <% }) %>
    </div>
    <% } else { %>
    <h2>This category does not exist</h2>
    <% } %>

  </div>
</body>

</html>