<head>
  <link rel="stylesheet" href="/components.css">
</head>
<a href="/items/<%=item.item_id%>">
  <div class="card item-card">
    <h2><%= item.name %></h2>
    <div>
      <% if (item.price) { %>
      <p>Price: $<%= item.price %></p>
      <% } %>
      <% if (item.stock) { %>
      <p>Stock: <%= item.stock %></p>
      <% } %>
    </div>
  </div>
</a>